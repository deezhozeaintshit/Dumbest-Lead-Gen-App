# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Port (defaults to 3000 in this container environment)
PORT=3000

# SQLite Database URL for Prisma
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET="lead_ingestion_pipeline_super_secret_jwt_key_2026"

# Optional B2B Contact & Place Provider API Keys
# Note: SEC EDGAR Official Corporate Registry & OpenStreetMap Commercial Directory work out-of-the-box without keys.
GOOGLE_PLACES_API_KEY=""
APOLLO_API_KEY=""
HUNTER_API_KEY=""

# Optional Commercial Email Verification APIs
# Note: Built-in DNS MX record validation and RFC syntax verifier work out-of-the-box without keys.
ABSTRACT_API_KEY=""
ZEROBOUNCE_API_KEY=""
